# Kulso Mongo eseten az authSource altalaban "admin" (ott van a user letrehozva).
# Nelkule a driver az URI utvonalan levo DB-hez autentikal -> AuthenticationFailed (code 18).
# A jelszo specialis karaktereit URL-kodolni kell (+ -> %2B, @ -> %40, # -> %23).
MONGO_URI=mongodb://user:pass@host:27017/shadow_signals?authSource=admin
TELEGRAM_BOT_TOKEN=replace_me
TELEGRAM_CHAT_ID=replace_me
LOG_LEVEL=INFO
